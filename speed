-- Steal an Egg | Speed Bypass | by adnqcr7-code
-- Based on l10scripts method | Works on Xeno, Delta, Krnl

local SPEED = 500

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Check executor
if not getgc then
    warn("[Speed] Missing getgc - executor too weak")
    return
end
if not hookfunction then
    warn("[Speed] Missing hookfunction - executor too weak")
    return
end
if not islclosure then
    warn("[Speed] Missing islclosure - executor too weak")
    return
end

-- Find the anticheat function (l10scripts method)
local function findfunction(nups, linedefined)
    for _, f in next, getgc() do
        if typeof(f) == 'function' and islclosure(f) then
            local upvs = debug.getupvalues(f)
            local line = debug.info(f, "l")
            if upvs and #upvs == nups and line == linedefined then
                if nups == 10 then
                    local t = debug.getupvalue(f, 3)
                    if typeof(t) == "table" and rawget(t, "Humanoid") then
                        return f
                    end
                else
                    return f
                end
            end
        end
    end
    return nil
end

local func3 = findfunction(19, 3)
if not func3 then
    warn("[Speed] Failed to find anticheat function (19 upvalues, line 3)")
    return
end

local v7 = debug.getupvalue(func3, 2)
if not v7 then
    warn("[Speed] Failed to get v7 upvalue")
    return
end

local hookedfunc3
hookedfunc3 = hookfunction(v7, newlclosure(function(p1, p2)
    if p2 and typeof(p2) == "table" then
        setmetatable(p2, {})
    end
    return hookedfunc3(p1, p2)
end))

print("[Speed] Anticheat bypassed. Applying speed...")

-- Apply speed
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    hum.WalkSpeed = SPEED
end)

-- UI
task.wait(1)
local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
if not pg then pg = Instance.new("PlayerGui", LocalPlayer) end

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(180, 50)
frame.Position = UDim2.new(0, 20, 0, 80)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
frame.BorderSizePixel = 0
frame.Parent = pg
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "Speed: ON (" .. SPEED .. ")"
label.TextColor3 = Color3.fromRGB(80, 255, 80)
label.TextSize = 14
label.Font = Enum.Font.GothamBold
label.Parent = frame

-- Draggable
local dragging, dragStart, frameStart
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        frameStart = frame.Position
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        frame.Position = UDim2.new(
            frameStart.X.Scale, frameStart.X.Offset + (input.Position.X - dragStart.X),
            frameStart.Y.Scale, frameStart.Y.Offset + (input.Position.Y - dragStart.Y)
        )
    end
end)

print("[Speed] Done. Speed " .. SPEED .. " applied.")   
